{
  "name": "growercare-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:grower": "pnpm --filter grower-web dev",
    "dev:staff": "pnpm --filter staff-console dev",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node scripts/coverage-summary.mjs",
    "build": "pnpm -r --filter \"./apps/*\" build",
    "budget": "node scripts/bundle-budget.mjs",
    "i18n:check": "node scripts/i18n-check.mjs",
    "contracts:sync": "node scripts/sync-contracts.mjs",
    "api:generate": "orval --config packages/api-client/orval.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.11.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "msw": "^2.15.0",
    "orval": "^8.48.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

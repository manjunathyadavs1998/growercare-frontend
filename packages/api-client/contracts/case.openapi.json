                    "$ref": "#/components/schemas/CaseTypeInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "case-type-controller"
        ]
      }
    },
    "/cases": {
      "get": {
        "operationId": "list",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "pattern": "^[A-Z][A-Z_]{1,39}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "caseType",
            "required": false,
            "schema": {
              "pattern": "^[A-Z][A-Z_]{1,39}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "territoryId",
            "required": false,
            "schema": {
              "pattern": "^[1-9][0-9]{0,18}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "assignedToMe",
            "required": false,
            "schema": {
              "default": false,
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "createdFrom",
            "required": false,
            "schema": {
              "format": "date-time",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "queue",
            "required": false,
            "schema": {
              "pattern": "^[A-Z]{2}-[A-Z0-9-]{2,40}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "slaState",
            "required": false,
            "schema": {
              "enum": [
                "ON_TRACK",
                "AT_RISK",
                "BREACHED",
                "MET",
                "MISSED"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "growerId",
            "required": false,
            "schema": {
              "pattern": "^[1-9][0-9]{0,18}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "productId",
            "required": false,
            "schema": {
              "pattern": "^[1-9][0-9]{0,18}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "batchNo",
            "required": false,
            "schema": {
              "pattern": "^[A-Z0-9-]{4,32}$",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/CasePage"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "case-controller"
        ]
      },

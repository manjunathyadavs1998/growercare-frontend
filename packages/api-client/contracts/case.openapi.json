  "info": {
    "description": "GrowerCare case-service. Errors are RFC 9457 problem+json; IDs are strings.",
    "title": "case-service",
    "version": "v1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/case-types": {
      "get": {
        "operationId": "caseTypes",
        "responses": {
          "200": {
            "content": {
